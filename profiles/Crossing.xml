<?xml version="1.0" encoding="UTF-8"?>
<ComponentSpec xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" isProfile="true"
    CMDVersion="1.2" CMDOriginalVersion="1.2"
    xsi:noNamespaceSchemaLocation="https://infra.clarin.eu/CMDI/1.x/xsd/cmd-component.xsd">
    <Header>
        <ID>clarin.eu:cr1:p_Crossing</ID>
        <Name>Crossing</Name>
        <Description/>
        <Status>development</Status>
    </Header>
    <Component name="Crossing" CardinalityMin="1" CardinalityMax="1">
        <Component name="Voyage_ID">
            <Element name="voyageid" ValueScheme="string"/>
        </Component>
        <Component name="Corporate"/>
        <Component name="Vessel">
            <Element name="name" ValueScheme="string"/>
            <Element name="flags">
                <ValueScheme>
                    <Vocabulary>
                        <enumeration>
                            <item>denmark-baltic</item>
                            <item>france</item>
                            <item>gb</item>
                            <item>netherlands</item>
                            <item>portugal-brazil</item>
                            <item>spain-uruguay</item>
                            <item>sweden</item>
                            <item>usa</item>
                            <item>other</item>
                        </enumeration>
                    </Vocabulary>
                </ValueScheme>
            </Element>
            <Element name="tonnage" ValueScheme="int"/>
        </Component>
        <Component name="Journey">
            <Element name="startyear" ValueScheme="int"/>
            <Element name="departure_location" ValueScheme="string"/>
            <Element name="endyear" ValueScheme="int"/>
            <Element name="arrival_location" ValueScheme="string"/>
        </Component>
        <Component name="Enslaved_people">
            <Element name="principal_purchase_location" ValueScheme="string"/>
            <Element name="principal_landing_location" ValueScheme="string"/>
            <Element name="embarked" ValueScheme="int"/>
            <Element name="disembarked" ValueScheme="int"/>
            <Element name="deaths" ValueScheme="int"/>
        </Component>
        <Component name="Outcome"/>
    </Component>
</ComponentSpec>
