<?xml version="1.0" encoding="UTF-8"?>
<ComponentSpec xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" isProfile="true"
    CMDVersion="1.2" CMDOriginalVersion="1.2"
    xsi:noNamespaceSchemaLocation="https://infra.clarin.eu/CMDI/1.x/xsd/cmd-component.xsd">
    <Header>
        <ID>clarin.eu:cr1:p_Organisation</ID>
        <Name>Organisation</Name>
        <Description/>
        <Status>development</Status>
    </Header>
    <Component name="Organisation" CardinalityMin="1" CardinalityMax="1">
        <Element name="economic_sector">
            <ValueScheme>
                <Vocabulary>
                    <enumeration>
                        <item>banking</item>
                        <item>charity</item>
                        <item>commerce</item>
                        <item>government</item>
                        <item>infrastructure</item>
                        <item>insurance</item>
                        <item>land</item>
                        <item>manufacturing</item>
                        <item>mining</item>
                        <item>shipping</item>
                    </enumeration>
                </Vocabulary>
            </ValueScheme>
        </Element>
        <Element name="region_clone" ValueScheme="string"/>
        <Element name="category">
            <ValueScheme>
                <Vocabulary>
                    <enumeration>
                        <item>Business</item>
                        <item>Charity</item>
                        <item>Educational</item>
                        <item>Hospitals</item>
                        <item>Imperial</item>
                        <item>Legal</item>
                        <item>Livery</item>
                        <item>Military</item>
                        <item>Parish</item>
                        <item>Political</item>
                        <item>Religious</item>
                        <item>Scientific</item>
                        <item>Social</item>
                        <item>State</item>
                    </enumeration>
                </Vocabulary>
            </ValueScheme>
        </Element>
        <Element name="description_of_activities" ValueScheme="string"/>
        <Component name="Slave_trading">
            <Element name="slave_trading" ValueScheme="string"/>
            <Element name="is_associated">
                <ValueScheme>
                    <Vocabulary>
                        <enumeration>
                            <item>yes</item>
                            <item>no</item>
                            <item>inferred</item>
                        </enumeration>
                    </Vocabulary>
                </ValueScheme>
            </Element>
            <Element name="year_of_first_participation" ValueScheme="int"/>
            <Element name="year_of_last_participation" ValueScheme="int"/>
        </Component>
    </Component>
</ComponentSpec>
