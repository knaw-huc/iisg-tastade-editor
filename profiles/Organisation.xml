<?xml version="1.0" encoding="UTF-8"?>
<ComponentSpec xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" isProfile="true"
    CMDVersion="1.2" CMDOriginalVersion="1.2"
    xsi:noNamespaceSchemaLocation="https://infra.clarin.eu/CMDI/1.x/xsd/cmd-component.xsd">
    <Header>
        <ID>clarin.eu:cr1:p_Organisation</ID>
        <Name>Organisation</Name>
        <Description/>
        <Status>development</Status>
    </Header>
    <Component name="Organisation" CardinalityMin="1" CardinalityMax="1">
        <Component name="Economic_sector"/>
        <Component name="Region">
            <Element name="region_clone" ValueScheme="string"/>
        </Component>
        <Component name="Category"/>
        <Component name="Description_of_Activities"/>
        <Component name="Slave_trading">
            <Element name="is_associated">
                <ValueScheme>
                    <Vocabulary>
                        <enumeration>
                            <item>yes</item>
                            <item>no</item>
                            <item>inferred</item>
                        </enumeration>
                    </Vocabulary>
                </ValueScheme>
            </Element>
            <Element name="year_of_first_participation" ValueScheme="int"/>
            <Element name="year_of_last_participation" ValueScheme="int"/>
        </Component>
    </Component>
</ComponentSpec>
