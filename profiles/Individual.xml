        </Component>
        <Component name="Primary_Cohort">
            <Element name="cohort">
                <ValueScheme>
                    <Vocabulary>
                        <enumeration>
                            <item>Liverpool</item>
                            <item>Bristol</item>
                            <item>London</item>
                            <item>Minor Ports</item>
