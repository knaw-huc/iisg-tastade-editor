			<Component name="ObservationLocator" CardinalityMin="0" CardinalityMax="1">
				<Documentation>Component for the data property assertions that specify where exactly an Observation is located or appears in the Source where it was extracted from.</Documentation>
				<Element name="pageScanUrl" ConceptLink="http://data.tastade.org/ontology/pageScanUrl" ValueScheme="string" CardinalityMin="1" CardinalityMax="0" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
