		<Component name="RecordWorkflowStatus" ComponentRef="clarin.eu:cr1:c_1784045962448" CardinalityMin="1" CardinalityMax="1">
			<Documentation>Explained in the project documentation (add link:...)</Documentation>
			<Element name="recordStatus" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>To indicate the stage the record is at in terms of completeness. For example, for a Source: all relevant data has been extracted from the source, or if there is still data that could be extracted at a later stage. For an Entity observation: if it is an initial draft, or if all the observation-related data is entered.</Documentation>
				<ValueScheme>
					<Vocabulary>
						<enumeration>
							<item ConceptLink="" AppInfo="Use for sources which are not yet analized, no data is extracted">toDo</item>
							<item ConceptLink="" AppInfo="Use for Entities (e.g., Actor) which are created quickly but no data is yet extracted">draft</item>
							<item ConceptLink="" AppInfo="Use for Sources or Entities for which some data has been extracted, but there are still other pieces of data to be extracted">inProgress</item>
							<item ConceptLink="" AppInfo="all relevant data from this Source or Entity has been extracted">done</item>
						</enumeration>
					</Vocabulary>
				</ValueScheme>
			</Element>
