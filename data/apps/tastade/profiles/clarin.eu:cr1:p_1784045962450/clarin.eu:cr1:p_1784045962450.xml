			<Element name="nameOrTitle" ConceptLink="https://schema.org/name" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" Multilingual="false" cue:DisplayPriority="1" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>The name of a Source. For Sources: Use a user-friendly name to identify the source. Depending on the Source type, this may contain a combination of it's name, year of creation, creator, et cetera. </Documentation>
			</Element>
			<Element name="mainType" ConceptLink="http://purl.org/dc/terms/type" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="2" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>Recommendation for vocabularies to use: https://www.w3.org/TR/vocab-dcat-3/#Property:resource_type. You can use a term from the PiCo thesaurus for Source types: https://terms.personsincontext.org/sourcetypes . (Internal note: this property is related but is not the same as this one in PiCo: https://schema.org/additionalType).</Documentation>
				<ValueScheme>
					<Vocabulary>
						<enumeration>
<!--							<item ConceptLink="http://id.loc.gov/vocabulary/marcgt/let">letter</item>-->
							<item ConceptLink="https://www.wikidata.org/wiki/Q36279">Biography</item>
							<item ConceptLink="https://www.wikidata.org/wiki/Q1385610">Excerpt</item>
							<item ConceptLink="https://www.wikidata.org/wiki/Q155656">Will</item>
						</enumeration>
					</Vocabulary>
				</ValueScheme>
			</Element>
			<Element name="additionalSourceType" ConceptLink="https://schema.org/additionalType" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="3" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>"An additional type for the item, typically used for adding more specific types from external vocabularies in microdata syntax. This is a relationship between something and a class that the thing is in. Typically the value is a URI-identified RDF class, and in this case corresponds to the use of rdf:type in RDF. Text values can be used sparingly, for cases where useful information can be added without their being an appropriate schema to reference. In the case of text values, the class label should follow the schema.org style guide." See PiCo's vocabulary:  https://personsincontext.org/model/#https://schema.org/additionalType</Documentation>
				<ValueScheme>
					<Vocabulary>
						<enumeration>
							<item ConceptLink="https://www.wikidata.org/wiki/Q112754">Primary source</item>
							<item ConceptLink="https://www.wikidata.org/wiki/Q905511">Secondary source</item>
							<item ConceptLink="https://www.wikidata.org/wiki/Q1063801">Tertiary source</item>
						</enumeration>
					</Vocabulary>
				</ValueScheme>
			</Element>
			<Element name="internalType" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="4" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>To use for internal classification of sources (e.g., primary, secondary; or any other useful classifications which vary per project).</Documentation>
				<ValueScheme>
					<Vocabulary>
						<enumeration>
							<item ConceptLink="">High</item>
							<item ConceptLink="">Medium</item>
							<item ConceptLink="">Low</item>
							<item ConceptLink="">Disputed</item>
							<item ConceptLink="">Uncertain</item>
						</enumeration>
					</Vocabulary>
				</ValueScheme>
			</Element>
			<Element name="accessURL" ConceptLink="https://www.w3.org/ns/dcat#accessURL" ValueScheme="string" CardinalityMin="1" CardinalityMax="1" cue:DisplayPriority="5" xmlns:cue="http://www.clarin.eu/cmd/cues/1">
				<Documentation>A URL of the resource that gives access to it. In PiCo: A media object, usually a scan, that encodes the Source of a Person observation (https://schema.org/associatedMedia).</Documentation>
			</Element>
